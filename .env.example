# ============================================================================
# TriageMail — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- Auth (NextAuth / Auth.js) ---
AUTH_SECRET=
# generate with: openssl rand -base64 32
AUTH_URL=http://localhost:3000
# in prod set to https://triagemail.vercel.app

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Console: https://console.cloud.google.com/apis/credentials
# Type: Web application
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://triagemail.vercel.app/api/auth/callback/google
# Scopes (added in code, not console):
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/gmail.compose
#   https://www.googleapis.com/auth/gmail.labels

# --- AI Gateway (Vercel) ---
# ONE key for all models. Use strings like 'anthropic/claude-haiku-4-5'.
# In Vercel deployment, OIDC auto-resolves and this is OPTIONAL.
AI_GATEWAY_API_KEY=
# Generate at: https://vercel.com/ai-gateway

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# Get at: https://elevenlabs.io/app/settings/api-keys
# Free tier: 10,000 credits/month ≈ 10 min TTS

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Service role bypasses RLS — server-only, never expose to client.

# --- Cron + MCP protection ---
CRON_SECRET=
# generate with: openssl rand -base64 32
# Used as: Authorization: Bearer $CRON_SECRET on /api/cron/*

MCP_PUBLIC=true
# true = MCP server accessible without auth (jurado puede probarlo)
# false = require Supabase JWT in user_token param

# --- App URL ---
NEXT_PUBLIC_APP_URL=https://triagemail.vercel.app
