# ============================================================================
# TriageMail — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- Auth (NextAuth / Auth.js) ---
AUTH_SECRET=
# generate with: openssl rand -base64 32
AUTH_URL=http://localhost:3000
# in prod set to https://triagemail.vercel.app

# --- Google OAuth (Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Console: https://console.cloud.google.com/apis/credentials
# Type: Web application
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://triagemail.vercel.app/api/auth/callback/google
# Scopes (added in code, not console):
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/gmail.compose
#   https://www.googleapis.com/auth/gmail.labels

# --- AI Gateway (Vercel) ---
# ONE key for all models. Use strings like 'anthropic/claude-haiku-4-5'.
# In Vercel deployment, OIDC auto-resolves and this is OPTIONAL.
AI_GATEWAY_API_KEY=
# Generate at: https://vercel.com/ai-gateway

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
# Get at: https://elevenlabs.io/app/settings/api-keys
# Free tier: 10,000 credits/month ≈ 10 min TTS

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Service role bypasses RLS — server-only, never expose to client.

# --- Cron + MCP protection ---
CRON_SECRET=
# generate with: openssl rand -base64 32
# Used as: Authorization: Bearer $CRON_SECRET on /api/cron/*

MCP_PUBLIC=true
# true = MCP server accessible without auth (jurado puede probarlo)
# false = require Supabase JWT in user_token param

# --- App URL ---
NEXT_PUBLIC_APP_URL=https://try-emily.vercel.app

# ============================================================================
# Senior + Junior MCP architecture (Automode)
# ============================================================================
# Emily's Automode usa una jerarquía de modelos:
#   Senior  = Claude Opus 4.7 (este repo, ya configurado vía AI Gateway).
#   Juniors = Gemini-en-Gmail y Copilot-en-Outlook, expuestos como MCP servers
#             EXTERNOS open-source. La autoridad OAuth (Gmail / MS Graph) vive
#             en el junior MCP, no en TriageMail.
#
# Si las env vars NO están configuradas, las tools junior_compose_* devuelven
# una offline envelope y el Senior procede a redactar él mismo. Build y
# Automode no rompen.
#
# Community MCPs candidatos (verificar mantenimiento al pinear):
#   Gmail   → GongRzhe/Gmail-MCP-Server
#   Outlook → softeria/ms-365-mcp-server  o  merill/lokka

JUNIOR_MCP_GMAIL_URL=
JUNIOR_MCP_GMAIL_TOKEN=
# Bearer token para autenticarse contra el junior Gmail MCP. En el slice
# usamos single-tenant (un solo OAuth-token reutilizado). Multi-tenant
# pass-through queda en roadmap.

JUNIOR_MCP_OUTLOOK_URL=
JUNIOR_MCP_OUTLOOK_TOKEN=
# Mismo patrón para Outlook/M365. La tool junior_compose_outlook está
# definida pero unreachable hasta que el provider Outlook tenga ingest.

# ============================================================================
# Propósitos organizacionales (alignment validation)
# ============================================================================
# Lista JSON de strings con los propósitos del usuario. Emily los inyecta en
# los system prompts y valida cada draft contra ellos antes de pedir
# aprobación. Si no se configura, hay un default genérico defendible para el
# nicho cooperación internacional.
ORG_PURPOSES_JSON=
# Ejemplo:
# ORG_PURPOSES_JSON='["Conservación marina costera","Fortalecer redes locales de M&E","Salvaguardas ESG en proyectos extractivos"]'
